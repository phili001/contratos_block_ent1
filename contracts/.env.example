# Copia este archivo a .env y llena los valores. .env esta en .gitignore.
# NUNCA uses una llave privada con fondos reales: crea una wallet nueva solo para testnet.

# RPC de Sepolia (Alchemy, Infura o similar). OPCIONAL: si lo dejas vacio se usa
# un RPC publico, que funciona pero es mas lento y tiene limites de peticiones.
SEPOLIA_RPC_URL=

# OBLIGATORIA para desplegar en Sepolia.
# Llave privada (0x + 64 caracteres hex) de la wallet que despliega y firma.
DEPLOYER_PRIVATE_KEY=

# Opcional, para verificar el contrato en Etherscan
ETHERSCAN_API_KEY=

# Pon "true" para ver el reporte de gas al correr los tests
REPORT_GAS=false
